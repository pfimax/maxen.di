<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Uncomment to write what the generator produced to obj/generated, so you can read it. -->
    <!-- <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/generated</CompilerGeneratedFilesOutputPath> -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maxen.DI\Maxen.DI.csproj" />
    <!-- In your own project the generator and analyzers arrive with the Maxen.DI package; here they are referenced directly. -->
    <ProjectReference Include="..\..\src\Maxen.DI.Generators\Maxen.DI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
