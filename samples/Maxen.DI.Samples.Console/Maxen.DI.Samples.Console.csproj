<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The tour doubles as the native AOT check: publish it to prove the core stays trim-safe. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maxen.DI\Maxen.DI.csproj" />
    <!-- In your own project the analyzers and generator come with the Maxen.DI package; here they are referenced directly. -->
    <ProjectReference Include="..\..\src\Maxen.DI.Generators\Maxen.DI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
