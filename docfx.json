{
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "src/Maxen.DI/Maxen.DI.csproj",
            "src/Maxen.DI.Extensions.DependencyInjection/Maxen.DI.Extensions.DependencyInjection.csproj",
            "src/Maxen.DI.Extensions.AspNetCore/Maxen.DI.Extensions.AspNetCore.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": { "TargetFramework": "net10.0" }
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["docs/**.md", "docs/toc.yml", "toc.yml", "index.md"] }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "Maxen.DI",
      "_appName": "Maxen.DI",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.svg",
      "_appFooter": "<span class=\"mx-footer\"><span>Maxen.DI is MIT licensed.</span><a href=\"https://github.com/pfimax/maxen.di\">GitHub</a><a href=\"https://www.nuget.org/packages/Maxen.DI\">NuGet</a><a href=\"https://github.com/pfimax/maxen.di/blob/main/CHANGELOG.md\">Changelog</a><a href=\"https://github.com/pfimax/maxen.di/tree/main/samples\">Samples</a></span>",
      "_enableSearch": true
    },
    "template": ["default", "modern", "template"]
  }
}
